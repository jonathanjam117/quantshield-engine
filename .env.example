# QuantShield Environment Configuration Template
# Renombra este archivo a .env y añade tus credenciales

# The Odds API Key (Obtén tu API key gratuita con 500 peticiones/mes en https://the-odds-api.com)
THE_ODDS_API_KEY=your_the_odds_api_key_here

# Google Gemini API Key para Agente de Contexto Táctico (Plan Pro)
GEMINI_API_KEY=your_gemini_api_key_here

# Configuración de Bot de Telegram para Alertas (Opcional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
